datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  password     String
  name         String
  role         Role           @default(STUDENT)
  
  // Student specific fields
  studentId    String?        @unique
  program      String?
  level        String?
  
  submissions  Submission[]
  notifications Notification[]
  
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

enum Role {
  STUDENT
  ADMIN
}

model Course {
  id            String   @id @default(uuid())
  code          String   @unique
  title         String
  credits       Int
  lecturer      String
  description   String?
  prerequisites String?
  schedule      String?
  venue         String?
  enrolled      Int      @default(0)
  capacity      Int      @default(100)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Join relationship for the courses a student selects in a submission
  submissions   SubmissionCourse[]
}

model Submission {
  id          String   @id @default(uuid())
  
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  
  status      SubmissionStatus @default(PENDING)
  submittedAt DateTime @default(now())
  documentUrl String?  // Stores the path or URL to the uploaded PDF file
  
  // A submission can contain multiple courses
  courses     SubmissionCourse[]
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Join table for many-to-many relationship between Submissions and Courses
model SubmissionCourse {
  submissionId String
  courseId     String
  
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@id([submissionId, courseId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  type      String
  title     String
  body      String
  time      DateTime @default(now())
  read      Boolean  @default(false)
}
