{
  "name": "ug-cs-registration",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @ug-cs/web dev",
    "dev:mobile": "pnpm --filter @ug-cs/mobile start",
    "build:web": "pnpm tokens:build && pnpm --filter @ug-cs/web build",
    "tokens:build": "pnpm --filter @ug-cs/design-tokens build",
    "tokens:watch": "pnpm --filter @ug-cs/design-tokens watch",
    "tokens:check": "pnpm --filter @ug-cs/design-tokens check",
    "design:lint": "pnpm --filter @ug-cs/design-tokens lint:colors",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
